{
  "type": "qsol-int-consumer-evaluation-contract",
  "protocol": "QSOL-INT/CONSUMER-EVALUATION/1",
  "version": "1.0.0",
  "status": "implemented",
  "scope": "exact_fixture_and_pinned_parent_evidence_only",
  "derived_noncanonical": true,
  "execution_claim_policy": {
    "synthetic_conformance_runs_must_set_claims_execution": false,
    "model_or_agent_runs_must_declare_execution_kind": true,
    "self_reported_identity_is_not_authenticated_identity": true
  },
  "metrics": [
    {
      "id": "provenance_retention",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "unknown_preservation",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "conflict_preservation",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "register_satire_preservation",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "mrs_interpretation",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "mode_boundary_discipline",
      "kind": "score",
      "minimum": 0,
      "maximum": 100,
      "direction": "higher_is_better"
    },
    {
      "id": "invented_history_penalty",
      "kind": "penalty",
      "minimum": 0,
      "maximum": 100,
      "direction": "lower_is_better"
    }
  ],
  "rules": [
    "evaluation_inputs_are_deterministic_synthetic_fixtures",
    "reports_bind_exact_fixture_index_and_parent_evidence_identity",
    "consumer_outputs_do_not_become_parent_or_source_evidence",
    "scores_measure_fixture_conformance_only",
    "unknown_and_conflict_must_remain_visible",
    "register_and_scenario_must_not_replace_claim_local_evidence_state",
    "mrs_selection_uses_explicit_capabilities_without_rank_inheritance",
    "material_cross_mode_inference_requires_a_declared_bridge",
    "unsupported_historical_claims_incur_a_penalty",
    "comparison_requires_identical_fixture_and_parent_evidence_identity",
    "comparison_does_not_establish_general_model_quality"
  ],
  "failure_codes": [
    "INT_EVALUATION_INDEX_INVALID",
    "INT_EVALUATION_CASE_INVALID",
    "INT_EVALUATION_ASSERTION_FAILED",
    "INT_CONSUMER_RUN_INVALID",
    "INT_CONSUMER_RESPONSE_MISSING",
    "INT_EVALUATION_IDENTITY_MISMATCH",
    "INT_EVALUATION_REPORT_INVALID",
    "INT_EVALUATION_COMPARISON_INVALID"
  ]
}
