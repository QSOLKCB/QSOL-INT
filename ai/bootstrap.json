{
  "type": "qsol-int-bootstrap",
  "protocol": "QSOL-INT",
  "version": "0.6.0",
  "load_order": [
    "manifest.json",
    "ai/parent-contracts.json",
    "snapshots/parents/index.json",
    "ai/integration-contract.json",
    "ai/integrity-semantics.json",
    "ai/epistemic-recovery-policy.json",
    "ai/reference-methodologies.json",
    "ai/composition-battery-contract.json",
    "batteries/index.json",
    "ai/consumer-evaluation-contract.json",
    "evaluations/index.json",
    "ai/adapter-contract.json",
    "adapters/index.json"
  ],
  "rules": [
    "parent_protocols_retain_semantic_authority",
    "pinned_parent_evidence_is_not_eternal_authority",
    "live_parent_state_may_supersede_stale_pins",
    "drift_is_never_silently_accepted",
    "missing_live_evidence_is_source_unavailable_not_no_drift",
    "snapshot_baselines_are_never_silently_refreshed",
    "snapshot_generation_time_is_not_semantic_identity",
    "unknown_parent_compatibility_fails_closed",
    "substrate_epistemic_state_does_not_directly_select_ark_tier",
    "ark_capabilities_are_explicit_only",
    "ark_mrs_selection_is_delegated_to_ark_semantics",
    "recovery_success_must_not_strengthen_claim_entitlement",
    "perfect_preservation_must_not_increase_epistemic_authority",
    "digest_match_is_not_authorship_or_truth",
    "source_design_inputs_are_noncanonical_by_default",
    "reference_methodologies_do_not_become_parent_authority",
    "authored_receiver_is_not_source_evidence",
    "compatibility_is_scope_qualified",
    "drift_detection_does_not_equal_compatibility",
    "pinned_compatibility_does_not_claim_live_parent_compatibility",
    "version_adjacency_does_not_imply_compatibility",
    "consumer_scores_measure_exact_fixture_conformance_only",
    "synthetic_consumer_runs_do_not_claim_execution",
    "consumer_comparisons_require_exact_fixture_and_parent_identity",
    "consumer_reports_and_comparisons_are_derived_noncanonical",
    "adapters_translate_transport_only",
    "adapter_messages_and_annotations_are_preserved_exactly",
    "adapter_output_is_not_parent_or_source_evidence",
    "adapter_receipts_do_not_prove_truth_authorship_execution_or_compatibility"
  ],
  "local_validation": "python3 tools/validate_int.py",
  "composition_validation": "python3 tools/run_batteries.py",
  "compatibility_report": "compatibility/reports/pinned-bootstrap.json",
  "parent_snapshot": "snapshots/parents/index.json",
  "live_parent_drift_detection": "./int check-drift",
  "drift_explanation": "./int explain-drift",
  "consumer_evaluation_validation": "./int validate-evaluations",
  "consumer_evaluation": "./int evaluate --run <run.json>",
  "consumer_comparison": "./int compare-evaluations --left <report.json> --right <report.json>",
  "adapter_validation": "./int validate-adapters",
  "adapter_translation": "./int adapt --adapter <generic|openai|ollama> --input <envelope.json>"
}
