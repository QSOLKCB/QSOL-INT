{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QSOL-INT Adapter Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol",
    "version",
    "id",
    "messages",
    "annotations"
  ],
  "properties": {
    "type": {
      "const": "qsol-int-adapter-envelope"
    },
    "protocol": {
      "const": "QSOL-INT/ADAPTER/1"
    },
    "version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "annotations": {
      "type": "object",
      "required": [
        "epistemic_state",
        "claim_maturity",
        "scenario",
        "register",
        "provenance",
        "mode",
        "drift"
      ],
      "properties": {
        "epistemic_state": {
          "type": "string"
        },
        "claim_maturity": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "register": {
          "type": "string"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary",
            "bridges",
            "material_cross_domain"
          ],
          "properties": {
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bridges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "material_cross_domain": {
              "type": "boolean"
            }
          }
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "review_required"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "review_required": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
