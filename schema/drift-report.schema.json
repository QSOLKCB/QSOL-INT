{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-INT/schema/drift-report.schema.json",
  "title": "QSOL-INT Drift Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocol", "report_version", "scope", "baseline_snapshot_id", "authority", "parents", "summary", "outcome", "status_codes"],
  "properties": {
    "type": {"const": "qsol-int-drift-report"},
    "protocol": {"const": "QSOL-INT/DRIFT/1"},
    "report_version": {"type": "string"},
    "scope": {"type": "string"},
    "baseline_snapshot_id": {"type": ["string", "null"]},
    "authority": {"type": "object"},
    "parents": {"type": "array"},
    "summary": {
      "type": "object",
      "required": ["detected_classes", "drift_detected", "classification_resolved", "review_required"],
      "properties": {
        "detected_classes": {
          "type": "array",
          "items": {"enum": ["NO_DRIFT", "CONTENT_DRIFT", "SCHEMA_DRIFT", "SEMANTIC_DRIFT", "CAPABILITY_DRIFT", "AUTHORITY_DRIFT", "BREAKING_DRIFT", "SOURCE_UNAVAILABLE"]},
          "uniqueItems": true
        },
        "drift_detected": {"type": "boolean"},
        "classification_resolved": {"type": "boolean"},
        "review_required": {"type": "boolean"}
      }
    },
    "outcome": {"enum": ["INT_OK", "INT_PARENT_DRIFT_DETECTED", "INT_PARENT_SOURCE_UNAVAILABLE", "INT_PARENT_SNAPSHOT_INVALID", "INT_PARENT_RECEIPT_MISMATCH", "INT_PARENT_CONTRACT_MISSING", "INT_DRIFT_CLASSIFICATION_UNRESOLVED", "INT_BREAKING_DRIFT", "INT_REVIEW_REQUIRED"]},
    "status_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "error": {"type": "string"}
  }
}
